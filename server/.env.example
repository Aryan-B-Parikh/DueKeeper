NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000

# SQLite (dev) — file path. Ignored when DATABASE_URL is set (PG prod).
DB_PATH=./data/duekeeper.db

# Postgres (prod) — when set, server uses PG + FOR UPDATE SKIP LOCKED for N workers
# Example: postgres://duekeeper:duekeeper@localhost:5432/duekeeper
DATABASE_URL=

# Redis (prod) — when set, outbox can use BullMQ delayed jobs + pub/sub for multi-instance
# Example: redis://localhost:6379
REDIS_URL=

JWT_SECRET=change-me-in-production-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=30

# Base64 of 32 random bytes. Encrypts stored Google OAuth tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Comma-separated older ENCRYPTION_KEY values, newest first. Rotation is: move the
# current key here, put a fresh one above, restart. Rows already encrypted stay
# readable — decryption tries every key listed here. Access tokens are re-encrypted
# under the new key on their next refresh, but a stored Google refresh token keeps
# its original key until the user reconnects, so keep the old key here until then.
# Every entry must itself be base64 of 32 bytes; a malformed one is refused at
# startup in production rather than skipped, because silently dropping it makes the
# rows that need it undecryptable.
PREVIOUS_ENCRYPTION_KEYS=

CORS_ALLOWED_ORIGINS=http://localhost:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DueKeeper <no-reply@duekeeper.local>

INBOX_DOMAIN=inbox.duekeeper.local
INBOX_WEBHOOK_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OUTBOX_LEASE_SECONDS=120
OUTBOX_CLAIM_LIMIT=50
OUTBOX_MAX_ATTEMPTS=3
