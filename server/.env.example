NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000

DB_PATH=./data/duekeeper.db

JWT_SECRET=change-me-in-production-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=30

ENCRYPTION_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DueKeeper <no-reply@duekeeper.local>

INBOX_DOMAIN=inbox.duekeeper.local
INBOX_WEBHOOK_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OUTBOX_LEASE_SECONDS=120
OUTBOX_CLAIM_LIMIT=50
OUTBOX_MAX_ATTEMPTS=3
